# Badcase 群事件订阅 daemon - 敏感配置示例
# 复制为 ~/.badcase_event_env 并填入真实值，建议 chmod 600 ~/.badcase_event_env
# 脚本启动时会自动 source 这个文件（set -a 导出为环境变量）。

# bigmodel Coding Plan API key（必填）。获取：ZCode 设置 / Coding Plan 后台。
# 用于 LLM 根因分析会话（ZCode headless 调 bigmodel 端点）。
ANTHROPIC_API_KEY="your_bigmodel_api_key_here"

# 可选：覆盖默认模型与端点（一般不用改）
# BIGMODEL_MODEL="bigmodel-coding-plan/glm-5.1"
# BIGMODEL_BASE_URL="https://open.bigmodel.cn/api/anthropic"

# 可选：覆盖监控目标群（默认是「【 Badcase 】Chatbot badcase 收集跟进群」）
# BADCASE_CHAT_ID="oc_d7a5dad130014974a65baf2b40e65ce5"

# 可选：单条 trace 分析超时秒数（trace 分析比普通分类重，默认放宽到 600）
# ANALYSIS_TIMEOUT=600

# 可选：模型限流时最大重试次数
# ZCODE_MAX_RETRY=3

# 可选：单次 consume 安全上限，到达后退出由 launchd 重启（避免长连接句柄累积）
# CONSUME_MAX_EVENTS=1000

# 可选：trace 解密等待板栗审批的最长时间（秒）
# DECRYPT_WAIT_TIMEOUT=900
